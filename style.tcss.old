/* GLOBAL */
Screen { background: #1a1b26; color: #a9b1d6; }

/* ================= LAYOUT ================= */

#main_split {
    height: 1fr;
    layout: horizontal;
}

/* LEFT COL: Panels + Hand */
#left_col {
    width: 3fr;
    layout: vertical;
}

#entities_row {
    height: 60%;
    layout: horizontal;
    border-bottom: heavy #565f89;
}

#hand_row {
    height: 40%;
    layout: vertical;
    background: #1f2335;
    border-right: solid #565f89;
}

/* RIGHT COL: Inspector + Log */
#right_col {
    width: 1fr;
    layout: vertical;
    background: #1a1b26;
    border-left: heavy #7aa2f7;
}

#log_view {
    height: 1fr;
    border-bottom: solid #565f89;
    background: #16161e;
}

#inspector {
    height: 1fr;
    background: #24283b;
    padding: 1;
}

/* ================= WIDGETS ================= */

/* --- ENTITY PANELS --- */
.entity_container {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    layout: vertical;
}
.entity_container.enemy { background: #1a1b26; border-right: solid #565f89; }
.entity_container.player { background: #16161e; }

/* Lists inside Entity Panels */
.field_list {
    height: auto;
    max-height: 6; /* Limit height */
    border: none;
    background: transparent;
}
.field_list:focus { border-left: double #ff9e64; }

/* Items in Field Lists */
FieldItem { padding: 0 1; color: #c0caf5; }
FieldItem:hover { background: #292e42; }
FieldItem.--highlight { background: #3b4261; color: #7aa2f7; text-style: bold; }

.panel_header {
    text-align: center;
    text-style: bold;
    color: #7aa2f7;
    border-bottom: solid #565f89;
    margin-bottom: 1;
    margin-top: 1;
}

/* --- HAND LIST --- */
#hand_list {
    height: 1fr;
    border: none;
    background: #1f2335;
}
#hand_list:focus { border-left: double #ff9e64; }

HandCardItem {
    padding: 1;
    border-bottom: solid #1a1b26;
}
HandCardItem:hover { background: #292e42; }
HandCardItem.--highlight {
    background: #ff9e64;
    color: black;
    text-style: bold;
    border-left: heavy white;
}

/* --- INSPECTOR (Passive) --- */
#inspect_title {
    text-align: center;
    color: #ff9e64;
    text-style: bold;
    border-bottom: solid #ff9e64;
    margin-bottom: 1;
}

/* --- ACTION MODAL --- */
ActionModal {
    align: center middle;
    background: rgba(0,0,0, 0.8);
}

#modal_dialog {
    width: 40;
    height: auto;
    background: #24283b;
    border: heavy #bb9af7;
    padding: 2;
}

#modal_title {
    text-align: center;
    text-style: bold;
    color: #bb9af7;
    border-bottom: solid #bb9af7;
    margin-bottom: 1;
}

.modal_btn { width: 100%; margin-bottom: 1; }
.modal_btn.primary { background: #7aa2f7; color: black; }
.modal_btn.danger { background: #f7768e; color: black; }

/* --- GLOBAL ACTIONS --- */
#global_actions_container {
    height: auto;
    min-height: 5;
    background: #1a1b26;
    border-top: solid #565f89;
    padding: 1;
}

.global_action_btn { width: 100%; margin-bottom: 1; border: none; }
.btn_pass { background: #7aa2f7; color: black; }
.btn_attack { background: #f7768e; color: black; }
.btn_mulligan { background: #e0af68; color: black; }

.hidden { display: none; }

/* HP Bar */
HealthBar { height: 1; margin-bottom: 1; }